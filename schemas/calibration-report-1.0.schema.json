{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragops.dev/schemas/calibration-report-1.0.schema.json",
  "title": "RAGOps evaluator calibration report 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluator", "decision", "case_count", "labeled_case_count", "coverage", "accuracy", "mae", "false_pass_rate", "false_block_rate", "reviewer_agreement", "reviewer_pair_count", "failed_gates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evaluator": {"type": "string", "minLength": 1},
    "decision": {"enum": ["PASS", "BLOCK"]},
    "case_count": {"type": "integer", "minimum": 1},
    "labeled_case_count": {"type": "integer", "minimum": 0},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "mae": {"type": "number", "minimum": 0, "maximum": 1},
    "false_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "false_block_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "reviewer_agreement": {"type": ["number", "null"]},
    "reviewer_pair_count": {"type": "integer", "minimum": 0},
    "failed_gates": {"type": "array", "items": {"type": "string"}},
    "confidence_band": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["threshold", "margin", "lower", "upper", "target_accuracy", "accuracy", "coverage", "decided_cases"],
      "properties": {
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "margin": {"type": "number", "minimum": 0, "maximum": 1},
        "lower": {"type": "number", "minimum": 0, "maximum": 1},
        "upper": {"type": "number", "minimum": 0, "maximum": 1},
        "target_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "decided_cases": {"type": "integer", "minimum": 1}
      }
    },
    "suggested_threshold": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["threshold", "accuracy", "false_pass_rate", "false_block_rate", "meets_false_pass_limit"],
      "properties": {
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "false_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "false_block_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "meets_false_pass_limit": {"type": "boolean"}
      }
    }
  }
}
